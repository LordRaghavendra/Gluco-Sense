<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:titleTextAppearance="@style/TextAppearance.HealthTracker.Title"
            app:title="@string/title_settings"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/on_surface" />

        <!-- Safe ranges -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_ranges"
            android:textAppearance="@style/TextAppearance.HealthTracker.Section"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_fasting_range"
                android:textAppearance="@style/TextAppearance.HealthTracker.Body"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/Widget.HealthTracker.TextInputLayout"
                    android:hint="@string/label_low"
                    android:layout_marginEnd="6dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editFastLow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/Widget.HealthTracker.TextInputLayout"
                    android:hint="@string/label_high"
                    android:layout_marginStart="6dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editFastHigh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_postmeal_range"
                android:textAppearance="@style/TextAppearance.HealthTracker.Body"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/Widget.HealthTracker.TextInputLayout"
                    android:hint="@string/label_low"
                    android:layout_marginEnd="6dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPostLow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/Widget.HealthTracker.TextInputLayout"
                    android:hint="@string/label_high"
                    android:layout_marginStart="6dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPostHigh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_bp_sys_range"
                android:textAppearance="@style/TextAppearance.HealthTracker.Body"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/Widget.HealthTracker.TextInputLayout"
                    android:hint="@string/label_low"
                    android:layout_marginEnd="6dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editSysLow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/Widget.HealthTracker.TextInputLayout"
                    android:hint="@string/label_high"
                    android:layout_marginStart="6dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editSysHigh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_bp_dia_range"
                android:textAppearance="@style/TextAppearance.HealthTracker.Body"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/Widget.HealthTracker.TextInputLayout"
                    android:hint="@string/label_low"
                    android:layout_marginEnd="6dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDiaLow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/Widget.HealthTracker.TextInputLayout"
                    android:hint="@string/label_high"
                    android:layout_marginStart="6dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDiaHigh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Reminders -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_reminders"
            android:textAppearance="@style/TextAppearance.HealthTracker.Section"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.HealthTracker.TextInputLayout"
                android:hint="@string/label_glucose_interval">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editGlucoseDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textSize="20sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGlucoseTime"
                style="@style/Widget.HealthTracker.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_glucose_time"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/label_medicine_enabled"
                    android:textAppearance="@style/TextAppearance.HealthTracker.BodyLarge" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMedEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMedicineTime"
                style="@style/Widget.HealthTracker.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_medicine_time"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Cloud -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_cloud"
            android:textAppearance="@style/TextAppearance.HealthTracker.Section"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/txtCloudStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.HealthTracker.BodyLarge"
                android:text="@string/label_not_signed_in" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignInOut"
                style="@style/Widget.HealthTracker.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_sign_in"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncNow"
                style="@style/Widget.HealthTracker.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_sync_now"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSettings"
            style="@style/Widget.HealthTracker.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save"
            android:minHeight="@dimen/big_button_min_height"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
