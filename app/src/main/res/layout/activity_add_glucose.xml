<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:titleTextAppearance="@style/TextAppearance.HealthTracker.Title"
            app:title="@string/title_add_glucose"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/on_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_glucose_value"
            android:textAppearance="@style/TextAppearance.HealthTracker.Section"
            android:layout_marginTop="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.HealthTracker.TextInputLayout"
            android:hint="@string/hint_glucose_value">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="28sp"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_context"
            android:textAppearance="@style/TextAppearance.HealthTracker.Section"
            android:layout_marginTop="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFasting"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ctx_fasting"
                android:textSize="18sp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBeforeMeal"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ctx_before_meal"
                android:textSize="18sp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAfterMeal"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ctx_after_meal"
                android:textSize="18sp"
                android:checkable="true" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_date_time"
            android:textAppearance="@style/TextAppearance.HealthTracker.Section"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickDate"
                style="@style/Widget.HealthTracker.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Today"
                android:layout_marginEnd="6dp"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickTime"
                style="@style/Widget.HealthTracker.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Now"
                android:layout_marginStart="6dp"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_note"
            android:textAppearance="@style/TextAppearance.HealthTracker.Section"
            android:layout_marginTop="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.HealthTracker.TextInputLayout"
            android:hint="@string/label_note">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_symptoms"
            android:textAppearance="@style/TextAppearance.HealthTracker.Section"
            android:layout_marginTop="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDizziness"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sym_dizziness"
                android:textSize="16sp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHeadache"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sym_headache"
                android:textSize="16sp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSweating"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sym_sweating"
                android:textSize="16sp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFatigue"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sym_fatigue"
                android:textSize="16sp"
                android:checkable="true" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.HealthTracker.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save"
            android:layout_marginTop="20dp"
            android:minHeight="@dimen/big_button_min_height"
            android:textSize="22sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
